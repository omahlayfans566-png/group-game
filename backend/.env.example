# =============================================
# SURVIVAL GAME - BACKEND ENVIRONMENT VARIABLES
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<db_username>:<password>@cluster0.icnxtha.mongodb.net/survivalgame?retryWrites=true&w=majority&appName=Cluster0

# JWT secret - use a long random string (32+ chars)
JWT_SECRET=replace_with_a_very_long_random_secret_string_here

# JWT expiry
JWT_EXPIRES_IN=7d

# Server port
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# WhatsApp group discussion link
GROUP_LINK=https://chat.whatsapp.com/xxxxxxxxxxxxxxx

# Node environment
NODE_ENV=development

# Admin registration secret (used once to create the first admin)
ADMIN_SECRET=replace_with_admin_registration_secret
