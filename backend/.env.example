# =============================================
# SURVIVAL GAME - BACKEND ENVIRONMENT VARIABLES
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<atlas-cluster-host>/<database_name>?retryWrites=true&w=majority

# JWT secret - use a long random string (32+ chars)
JWT_SECRET=<generate-a-long-random-secret>

# Render provides PORT automatically. The application defaults to 5000 locally.
PORT=5000

# Production frontend URL (used by HTTP CORS and Socket.IO)
CLIENT_URL=https://<frontend-service>.onrender.com

# WhatsApp group discussion link
GROUP_LINK=https://chat.whatsapp.com/<group-invite-code>

# Node environment
NODE_ENV=production

# Admin registration secret (used once to create the first admin)
ADMIN_SECRET=<generate-an-admin-registration-secret>

# Optional: defaults to 7d when omitted
JWT_EXPIRES_IN=7d

# Optional: set to false to use Render's DNS resolver instead of public DNS
NODE_DNS_OVERRIDE=false
