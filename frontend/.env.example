# Frontend environment variables
# Copy to .env and fill in values. VITE_* values are exposed to the browser.

# Backend API base URL. The existing client appends /auth, /games, and /challenges.
VITE_API_URL=https://your-backend-name.onrender.com/api

# Backend origin used by Socket.IO.
VITE_SOCKET_URL=https://your-backend-name.onrender.com

VITE_APP_NAME=SURVIVAL
VITE_GROUP_LINK=https://chat.whatsapp.com/your-group-invite-code
